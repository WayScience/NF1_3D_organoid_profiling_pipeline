params {
  config_profile_description = 'NF1 ZEDProfiler pilot base settings'
  run_id = null
  outdir = null
  manifest = 'manifest/nf0055_b10_1_alpine.yaml'
  feature_cpus = 2
  feature_memory = '32 GB'
  feature_time = '2h'
}

process {
  cpus = 1
  memory = '4 GB'
  time = '30 min'
  errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
  maxRetries = 2

  withLabel: zedprofiler_cpu {
    cpus = params.feature_cpus as int
    memory = params.feature_memory
    time = params.feature_time
  }
}
