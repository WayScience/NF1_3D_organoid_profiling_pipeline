params {
  config_profile_description = 'CURC Alpine Slurm profile for the NF1 ZEDProfiler pilot'
  slurm_account = System.getenv('NF1_PILOT_ACCOUNT') ?: ''
  slurm_partition = System.getenv('NF1_PILOT_PARTITION') ?: 'acpu'
  slurm_qos = System.getenv('NF1_PILOT_QOS') ?: 'cpu-normal'
  scratch_root = System.getenv('NF1_PILOT_SCRATCH') ?: ('/scratch/alpine/' + (System.getenv('USER') ?: 'unknown'))
  project_root = System.getenv('NF1_PILOT_PROJECT') ?: ('/projects/' + (System.getenv('USER') ?: 'unknown'))
}

process {
  executor = 'slurm'
  queue = params.slurm_partition
  scratch = true
  clusterOptions = ((params.slurm_account ? '--account=' + params.slurm_account : '') + ' ' + (params.slurm_qos ? '--qos=' + params.slurm_qos : '')).trim()
}

executor {
  name = 'slurm'
  queueSize = 20
  perJobMemLimit = true
  submitRateLimit = '20 / 1 min'
  killBatchSize = 50
}

env {
  UV_CACHE_DIR = "${params.project_root}/uv_cache"
  TMPDIR = "${params.scratch_root}/tmp"
}

/*
 * Reserved GPU seam only. Do not route CPU handcrafted ZEDProfiler tasks here.
 * SAMMed3D / morphem work should use a separate future process and a separate
 * GPU profile so aa100/gpu-normal resources are not mixed with acpu work.
 */
