params {
  config_profile_description = 'NF1 ZEDProfiler production base settings'
  run_id = null
  outdir = null
  manifest = 'manifest/smoke_test_image_set.yaml'
  image_sets = ''
  image_sets_index = ''
  source_root = ''
  uv_project_environment = System.getenv('NF1_PROD_UV_ENVIRONMENT') ?: ''
  feature_cpus = 2
  feature_memory = '32 GB'
  feature_time = '2h'
  warehouse_cpus = 2
  warehouse_memory = '64 GB'
  warehouse_time = '1h'
}

process {
  cpus = 1
  memory = '4 GB'
  time = '30 min'
  errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
  maxRetries = 2
  // koala is a shared group allocation: every file/dir a task creates
  // (parquet, validation.json, run_record.json, ...) needs to stay
  // group-writable, not just group-readable. beforeScript runs inside each
  // generated task wrapper script itself, before the process body, so this
  // holds regardless of whatever umask Slurm handed the job by default --
  // not something to rely on bin/nf1-nextflow-production's own umask
  // surviving the sbatch submission boundary.
  beforeScript = 'umask 007'

  withLabel: zedprofiler_cpu {
    cpus = params.feature_cpus as int
    memory = params.feature_memory
    time = params.feature_time
    // Found live in production: the top-level errorStrategy's 'finish' on
    // exhausted retries stops Nextflow from submitting any further tasks
    // and halts the whole session once in-flight tasks finish -- including
    // BUILD_WAREHOUSE, which then never runs, even with thousands of valid
    // completed image sets sitting on disk. Triggered by a single
    // genuinely bad image set (e.g. NF0014_T1/F11-3: one channel's z-stack
    // is one slice short of every other channel/mask -- a real source-data
    // problem, not something a retry can fix). Retries stay the same (2
    // attempts); only what happens after they're exhausted changes, and
    // only for this label -- PLAN_IMAGE_SETS/BUILD_WAREHOUSE keep the
    // stricter default 'finish' since a genuine failure there should still
    // halt the run, not be silently skipped.
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
  }

  withLabel: warehouse_cpu {
    cpus = params.warehouse_cpus as int
    memory = params.warehouse_memory
    time = params.warehouse_time
  }
}
