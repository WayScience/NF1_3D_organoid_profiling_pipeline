params {
  config_profile_description = 'CURC Alpine Slurm profile for the NF1 ZEDProfiler production workflow'
  slurm_account = System.getenv('NF1_PROD_ACCOUNT') ?: ''
  slurm_partition = System.getenv('NF1_PROD_PARTITION') ?: 'acpu'
  slurm_qos = System.getenv('NF1_PROD_QOS') ?: 'cpu-normal'
  scratch_root = System.getenv('NF1_PROD_SCRATCH') ?: ('/scratch/alpine/' + (System.getenv('USER') ?: 'unknown'))
  project_root = System.getenv('NF1_PROD_PROJECT') ?: ('/projects/' + (System.getenv('USER') ?: 'unknown'))
}

process {
  executor = 'slurm'
  queue = params.slurm_partition
  scratch = true
  clusterOptions = ((params.slurm_account ? '--account=' + params.slurm_account : '') + ' ' + (params.slurm_qos ? '--qos=' + params.slurm_qos : '')).trim()
}

// queueSize/killBatchSize raised toward 3a.nextflow_pilot's PLAN.md "Scenario B"
// (queueSize~=180, headroom under the amc-general account's MaxJobs=200 hard
// ceiling shared across every QOS this account uses) instead of the pilot's
// own queueSize=20, which PLAN.md identified as the dominant throughput
// bottleneck at production scale, not compute efficiency or Alpine's real
// limits. No submitRateLimit: PLAN.md's "Open questions for CURC" section
// records CURC already confirmed queueSize=200 with no rate limit is fine for
// a many-short-task workload like this one. Re-check current MaxJobs/queue
// contention with `sacctmgr`/`sinfo` before a full run -- this is a starting
// point, not a re-validated number.
executor {
  name = 'slurm'
  queueSize = 180
  perJobMemLimit = true
  killBatchSize = 50
}

env {
  UV_CACHE_DIR = "${params.project_root}/uv_cache"
  TMPDIR = "${params.scratch_root}/tmp"
}

/*
 * Reserved GPU seam only. Do not route CPU handcrafted ZEDProfiler tasks here.
 * SAMMed3D / morphem work should use a separate future process and a separate
 * GPU profile so aa100/gpu-normal resources are not mixed with acpu work.
 */
