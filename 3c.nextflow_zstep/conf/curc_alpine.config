params {
  config_profile_description = 'CURC Alpine Slurm profile for the NF1 ZEDProfiler z-step workflow'
  slurm_account = System.getenv('NF1_ZSTEP_ACCOUNT') ?: ''
  slurm_partition = System.getenv('NF1_ZSTEP_PARTITION') ?: 'acpu'
  slurm_qos = System.getenv('NF1_ZSTEP_QOS') ?: 'cpu-normal'
  scratch_root = System.getenv('NF1_ZSTEP_SCRATCH') ?: ('/scratch/alpine/' + (System.getenv('USER') ?: 'unknown'))
  project_root = System.getenv('NF1_ZSTEP_PROJECT') ?: ('/projects/' + (System.getenv('USER') ?: 'unknown'))
}

process {
  executor = 'slurm'
  queue = params.slurm_partition
  scratch = true
  clusterOptions = ((params.slurm_account ? '--account=' + params.slurm_account : '') + ' ' + (params.slurm_qos ? '--qos=' + params.slurm_qos : '')).trim()
}

// Only ~61 image sets (a few minutes of Slurm dispatch each), so queueSize
// far below the amc-general account's MaxJobs=200 ceiling is plenty; the
// production run's 180 mattered for 4200 tasks, not here. Tasks also carry
// very different memory requests (48 GB up to 224 GB -- see
// plan_image_sets.py's Z_STEP_RESOURCES), so a modest queue keeps Slurm's
// scheduler backfill effective instead of stacking many big tasks.
executor {
  name = 'slurm'
  queueSize = 24
  perJobMemLimit = true
  killBatchSize = 12
}

env {
  UV_CACHE_DIR = "${params.project_root}/uv_cache"
  TMPDIR = "${params.scratch_root}/tmp"
}

/*
 * Reserved GPU seam only. Do not route CPU handcrafted ZEDProfiler tasks here.
 * SAMMed3D / morphem work should use a separate future process and a separate
 * GPU profile so aa100/gpu-normal resources are not mixed with acpu work.
 */
